# ── Required ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-key-here

# ── Optional: better species ID ──────────────────────────────────────────
# Pl@ntNet for species identification. Sign up at https://my.plantnet.org
# (free tier is plenty for local dev). Without this key, species ID falls
# back to Gemini-only with reduced accuracy.
PLANTNET_API_KEY=

# ── Model selection (Gemini 3 lineup, May 2026) ──────────────────────────
# Orchestrator: needs strong agentic behavior. 3.5 Flash is the SOTA stable
# agentic Flash. For even better agentic behavior at higher cost, use
# gemini-3.1-pro (preview).
GEMINI_ORCHESTRATOR_MODEL=gemini-3.5-flash

# Detection: spatial-bbox output, needs good vision.
GEMINI_DETECTION_MODEL=gemini-3.5-flash

# Atomic visual QA: focused tools called many times per diagnosis. Cheap
# per-call matters; flash-lite is the budget multimodal option.
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite

# Fallback single-call diagnosis when MCP is down.
GEMINI_DIAGNOSIS_MODEL=gemini-3.5-flash

# ── Cost knobs ───────────────────────────────────────────────────────────
# Hard cap on tool calls per tree. Plan target is 4-9 adaptive calls.
MAX_TOOL_CALLS=6

# When true, trees marked "healthy" by detection skip the agent loop
# (saves ~70% on a healthy forest). Set false to deeply audit every tree.
SKIP_HEALTHY_DIAGNOSIS=true

# Tier-1 triage: a cheap single-call classifier between detection and the
# expensive agent loop. Most "monitor" / "treat" flags from per-frame
# detection are over-flagged; tier-1 weeds out false alarms for ~$0.0004
# each instead of $0.05 for the full agent. Trees scoring above the
# severity threshold get escalated to the full agent loop with their
# tier-1 indicators forwarded as context.
# gemini-3.5-flash gives reliable calibration. gemini-3.1-flash-lite is
# cheaper per call but over-anchors on detection's initial status → most
# trees end up escalated. Lite isn't worth the savings.
#
# Threshold 0.80 is the cost-conscious default: only severely
# compromised trees (0.8+) get the full agent; moderately stressed
# trees (0.55-0.79) get a tier-1-only fast-path diagnosis with the
# observed indicators surfaced. Drop to 0.55 if you need deep
# diagnoses on every borderline tree (3-4× the per-video cost).
TIER1_ENABLED=true
TIER1_MODEL=gemini-3.5-flash
TIER1_SEVERITY_THRESHOLD=0.80

# ── Server ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
